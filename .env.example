APP_ENV=development
API_BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=postgres://openrm:openrm@127.0.0.1:5432/openrm
RUN_MIGRATIONS=true
RUST_LOG=openrm_api=debug,tower_http=info

# `dev` is permitted only outside production and accepts Bearer dev:<subject>.
# Use `oidc` in deployed environments.
AUTH_MODE=dev
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=openrm-api

# Required in production. Development and test use an explicit non-production fallback.
EVIDENCE_SIGNING_KEY=openrm-development-evidence-key
EVIDENCE_SIGNING_KEY_ID=development
# Optional JSON object of historical key identifiers to key material for
# verification after an intentional signing-key rotation.
EVIDENCE_VERIFICATION_KEYS=

# Connector credentials stay outside PostgreSQL. The API stores only a secret reference.
JIRA_API_TOKEN=

# Optional OTLP/HTTP trace collector endpoint, for example http://127.0.0.1:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Vite only; defaults to the local API when omitted.
VITE_API_BASE_URL=http://127.0.0.1:8080

# Portable Docker Compose defaults. Change the bind address to 0.0.0.0 only
# when the host firewall and network exposure are intentional.
OPENRM_BIND_ADDRESS=127.0.0.1
OPENRM_PORT=8080
OPENRM_POSTGRES_BIND_ADDRESS=127.0.0.1
OPENRM_POSTGRES_PORT=5432
OPENRM_POSTGRES_DB=openrm
OPENRM_POSTGRES_USER=openrm
OPENRM_POSTGRES_PASSWORD=openrm
OPENRM_EVIDENCE_VERIFICATION_KEYS=

