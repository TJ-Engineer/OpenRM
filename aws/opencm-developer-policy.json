{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOpenCMSiteStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:537124952649:stack/opencm-demo/*"
    },
    {
      "Sid": "ListExactOpenCMBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::opencm-demo-537124952649-us-east-1"
    },
    {
      "Sid": "DeployOpenCMSiteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::opencm-demo-537124952649-us-east-1/*"
    },
    {
      "Sid": "InvalidateTaggedOpenCMDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::537124952649:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "opencm",
          "aws:ResourceTag/Environment": "demo"
        }
      }
    },
    {
      "Sid": "VerifyCaller",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
