{
  "name": "openrm-aws-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run test && npm run synth",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "deploy:registry": "cdk deploy OpenRmRegistry --strict",
    "deploy:platform": "cdk deploy OpenRmPlatform --strict"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "aws-cdk": "2.1148.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
