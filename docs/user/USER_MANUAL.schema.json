{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrm.dev/schemas/user-manual.schema.json",
  "title": "OpenRM user manual",
  "description": "Structured source format for the in-product OpenRM user manual.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "title",
    "summary",
    "metadata",
    "intro",
    "sections"
  ],
  "properties": {
    "$schema": {
      "const": "./USER_MANUAL.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "intro": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentVersion",
        "appliesTo",
        "owner",
        "lastVerified",
        "status"
      ],
      "properties": {
        "documentVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "appliesTo": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lastVerified": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/listBlock"
        },
        {
          "$ref": "#/$defs/subheadingBlock"
        }
      ]
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "note",
            "code"
          ]
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "listBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "enum": [
            "unordered-list",
            "ordered-list"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "subheadingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "title"
      ],
      "properties": {
        "type": {
          "const": "subheading"
        },
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
